<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget & Cost Breakdown -->
    <template id="traveloop_budget" name="Traveloop Budget">
        <t t-call="web.layout">
            <t t-set="head">
                <link rel="stylesheet"
                      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&amp;family=DM+Sans:wght@300;400;500;600&amp;display=swap"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
                <link rel="stylesheet" href="/traveloop/static/src/css/traveloop.css"/>
            </t>
            <body class="traveloop-page">
                <t t-set="active_nav" t-value="'budget'"/>
                <t t-call="traveloop.traveloop_navbar"/>

                <div class="tl-page-wrap container-fluid" style="max-width: 1280px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
                        <h1 class="section-title" style="margin:0;">Budget</h1>
                        <select class="tl-field" style="width:auto; padding: 10px 16px; border-radius:50px; border:1px solid var(--border);">
                            <t t-foreach="trips or []" t-as="t">
                                <option t-att-value="t.id" t-esc="t.trip_name"/>
                            </t>
                        </select>
                    </div>

                    <!-- A. Summary cards -->
                    <div class="tl-summary-grid">
                        <div class="tl-summary-card">
                            <div class="label">Total Budget</div>
                            <div class="value">₹<t t-esc="trip and trip.total_budget or 0"/></div>
                        </div>
                        <div class="tl-summary-card">
                            <div class="label">Total Spent</div>
                            <div class="value">₹<t t-esc="trip and trip.total_spent or 0"/></div>
                        </div>
                        <div class="tl-summary-card">
                            <div class="label">Remaining</div>
                            <div t-attf-class="value #{trip and trip.remaining_budget &lt; 0 and 'red' or 'green'}">
                                ₹<t t-esc="trip and trip.remaining_budget or 0"/>
                            </div>
                        </div>
                        <div class="tl-summary-card">
                            <div class="label">Budget Used</div>
                            <div class="value">
                                <t t-if="trip and trip.total_budget > 0">
                                    <t t-esc="int((trip.total_spent / trip.total_budget) * 100)"/>%
                                </t>
                                <t t-else="">0%</t>
                            </div>
                        </div>
                    </div>

                    <!-- B. Budget by Category -->
                    <div class="tl-card" style="padding:24px; margin-bottom:24px;">
                        <h3 class="section-title" style="margin-top:0;">Budget by Category</h3>
                        <t t-if="trip">
                            <t t-foreach="trip.budget_ids or []" t-as="b">
                                <div class="tl-cat-row">
                                    <div>
                                        <strong t-esc="b.category"/>
                                        <div style="color:var(--muted); font-size:0.8rem;">₹<t t-esc="b.amount"/></div>
                                    </div>
                                    <div class="tl-progress">
                                        <div class="tl-progress-fill" style="width: 60%;"/>
                                    </div>
                                    <div style="text-align:right; font-weight:600;">60%</div>
                                </div>
                            </t>
                        </t>
                    </div>

                    <!-- C. Expenses -->
                    <div class="tl-card" style="padding:24px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                            <h3 class="section-title" style="margin:0;">Expenses</h3>
                            <button type="button" class="btn-amber" data-bs-toggle="modal" data-bs-target="#tlExpenseModal">
                                + Add Expense
                            </button>
                        </div>
                        <table class="tl-table">
                            <thead>
                                <tr>
                                    <th>Date</th><th>Name</th><th>Category</th><th style="text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="trip">
                                    <t t-foreach="trip.expense_ids" t-as="e">
                                        <tr>
                                            <td t-esc="e.expense_date"/>
                                            <td t-esc="e.expense_name"/>
                                            <td>
                                                <t t-if="e.category == 'food'">🍜 Food</t>
                                                <t t-if="e.category == 'hotel'">🏨 Hotel</t>
                                                <t t-if="e.category == 'transport'">🚗 Transport</t>
                                                <t t-if="e.category == 'shopping'">🛍️ Shopping</t>
                                                <t t-if="e.category == 'other'">📦 Other</t>
                                            </td>
                                            <td style="text-align:right; font-weight:600;">₹<t t-esc="e.amount"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align:right; font-weight:600;">Total</td>
                                    <td style="text-align:right; font-weight:700; color: var(--amber);">
                                        ₹<t t-esc="trip and trip.total_spent or 0"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Add Expense Modal -->
                <div class="modal fade" id="tlExpenseModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius:20px;">
                            <form method="post" action="/traveloop/expense/save">
                                <div class="modal-header">
                                    <h5 class="modal-title">Add Expense</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                                </div>
                                <div class="modal-body">
                                    <div class="tl-field">
                                        <label>Expense Name *</label>
                                        <input type="text" name="expense_name" required="required"/>
                                    </div>
                                    <div class="tl-field">
                                        <label>Category *</label>
                                        <select name="category" required="required">
                                            <option value="food">🍜 Food</option>
                                            <option value="hotel">🏨 Hotel</option>
                                            <option value="transport">🚗 Transport</option>
                                            <option value="shopping">🛍️ Shopping</option>
                                            <option value="other">📦 Other</option>
                                        </select>
                                    </div>
                                    <div class="tl-field">
                                        <label>Amount *</label>
                                        <input type="number" name="amount" step="0.01" min="0" required="required"/>
                                    </div>
                                    <div class="tl-field">
                                        <label>Date *</label>
                                        <input type="date" name="expense_date" required="required"/>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn-outline-amber" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn-amber">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <script src="/traveloop/static/src/js/traveloop.js"/>
            </body>
        </t>
    </template>
</odoo>
